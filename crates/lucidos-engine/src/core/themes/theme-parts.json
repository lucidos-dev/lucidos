  "parts": [
    {
      "id": "chat-text",
      "label": "Chat text",
      "group": "chat",
      "description": "Prose in chat messages, yours and the agent's.",
      "selector": ".response-body .response-chunk, .response-body > .response-content > div:not([class]), .initiator-panel-bubble .user-bubble > .markdown-content",
      "frames": false,
      "properties": [
        {
          "name": "color",
          "token": "--part-chat-text-color",
          "default": "currentcolor"
        },
        {
          "name": "text-shadow",
          "token": "--part-chat-text-text-shadow",
          "default": "none"
        },
        {
          "name": "letter-spacing",
          "token": "--part-chat-text-letter-spacing",
          "default": "normal"
        }
      ]
    },
    {
      "id": "chat-heading",
      "label": "Chat headings",
      "group": "chat",
      "description": "Headings inside chat messages. Unset properties follow chat text.",
      "selector": ":is(.response-body .response-chunk, .response-body > .response-content > div:not([class]), .initiator-panel-bubble .user-bubble > .markdown-content) :is(h1, h2, h3, h4, h5, h6)",
      "parent": "chat-text",
      "frames": false,
      "properties": [
        {
          "name": "color",
          "token": "--part-chat-heading-color",
          "default": "var(--part-chat-text-color, var(--text-primary))"
        },
        {
          "name": "text-shadow",
          "token": "--part-chat-heading-text-shadow",
          "default": "var(--part-chat-text-text-shadow, none)"
        },
        {
          "name": "letter-spacing",
          "token": "--part-chat-heading-letter-spacing",
          "default": "var(--part-chat-text-letter-spacing, normal)"
        }
      ]
    },
    {
      "id": "chat-link",
      "label": "Chat links",
      "group": "chat",
      "description": "Links inside chat messages. An unset glow follows chat text.",
      "selector": ":is(.response-body .response-chunk, .response-body > .response-content > div:not([class]), .initiator-panel-bubble .user-bubble > .markdown-content) a",
      "parent": "chat-text",
      "frames": false,
      "properties": [
        {
          "name": "color",
          "token": "--part-chat-link-color",
          "default": "var(--accent)"
        },
        {
          "name": "text-shadow",
          "token": "--part-chat-link-text-shadow",
          "default": "var(--part-chat-text-text-shadow, none)"
        }
      ]
    },
    {
      "id": "inline-code",
      "label": "Inline code",
      "group": "chat",
      "description": "Inline code spans inside chat messages.",
      "selector": ":is(.response-body .response-chunk, .response-body > .response-content > div:not([class]), .initiator-panel-bubble .user-bubble > .markdown-content) code:not(pre > code)",
      "parent": "chat-text",
      "frames": false,
      "properties": [
        {
          "name": "color",
          "token": "--part-inline-code-color",
          "default": "var(--accent)"
        },
        {
          "name": "background-color",
          "token": "--part-inline-code-background-color",
          "default": "var(--bg-tertiary)"
        }
      ]
    },
    {
      "id": "code-block",
      "label": "Code blocks",
      "group": "chat",
      "description": "Fenced code blocks inside chat messages. An unset glow follows chat text.",
      "selector": ":is(.response-body .response-chunk, .response-body > .response-content > div:not([class]), .initiator-panel-bubble .user-bubble > .markdown-content) pre",
      "parent": "chat-text",
      "frames": false,
      "properties": [
        {
          "name": "background-color",
