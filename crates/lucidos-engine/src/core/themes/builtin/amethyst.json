{
  "name": "Amethyst",
  "description": "Charcoal and violet, with a violet wash on the focused header.",
  "author": "Lucidos",
  "credit": "After Obsidian's default theme.",
  "family": "violet",
  "dark": {
    "--bg-primary": "#1e1e1e",
    "--bg-secondary": "#262626",
    "--bg-tertiary": "#303030",
    "--bg-quaternary": "#3f3f3f",
    "--border-color": "#363636",
    "--bg-hover": "#2a2a2a",
    "--bg-selected": "#2f2b3d",
    "--text-primary": "#dadada",
    "--text-secondary": "#b3b3b3",
    "--text-muted": "#7a7a7a",
    "--accent": "#a68af9",
    "--accent-action": "#7f6df2",
    "--text-on-accent": "#ffffff",
    "--accent-green": "#44cf6e",
    "--accent-yellow": "#e0de71",
    "--accent-red": "#fb464c",
    "--accent-orange": "#e9973f",
    "--accent-notable": "#a0a0b8",
    "--header-bar-top": "#262626",
    "--header-bar-bottom": "#1e1e1e",
    "--header-fg": "#dadada",
    "--focus-header-tint": "color-mix(in srgb, #a68af9 14%, transparent)",
    "--focus-pill-bg": "#a68af9"
  },
  "light": {
    "--bg-primary": "#ffffff",
    "--bg-secondary": "#f6f6f6",
    "--bg-tertiary": "#ececec",
    "--bg-quaternary": "#e0e0e0",
    "--border-color": "#e0e0e0",
    "--bg-hover": "#f2f2f2",
    "--bg-selected": "#efeafd",
    "--text-primary": "#222222",
    "--text-secondary": "#5c5c5c",
    "--text-muted": "#8a8a8a",
    "--accent": "#7f6df2",
    "--text-on-accent": "#ffffff",
    "--accent-green": "#08b94e",
    "--accent-yellow": "#b08600",
    "--accent-red": "#e93147",
    "--accent-orange": "#ec7500",
    "--accent-notable": "#6b6b85",
    "--header-bar-top": "#f6f6f6",
    "--header-bar-bottom": "#efefef",
    "--header-fg": "#222222",
    "--focus-header-tint": "color-mix(in srgb, #7f6df2 12%, transparent)",
    "--focus-pill-bg": "#7f6df2"
  }
}
