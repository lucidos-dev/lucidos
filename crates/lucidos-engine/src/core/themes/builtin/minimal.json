{
  "name": "Minimal",
  "description": "Quiet neutral greys, a flat header that melts into the page, and an underline for focus.",
  "author": "Lucidos",
  "credit": "After Minimal, the Obsidian theme by kepano.",
  "family": "neutral",
  "fonts": { "ui": "geist" },
  "tokens": {
    "--radius-control": "0.375rem",
    "--radius-surface": "0.5rem",
    "--header-gradient": "var(--header-bar-top)",
    "--focus-header-tint": "transparent",
    "--focus-pill-glow": "none"
  },
  "dark": {
    "--bg-primary": "#1e1e1e",
    "--bg-secondary": "#262626",
    "--bg-tertiary": "#2e2e2e",
    "--bg-quaternary": "#3a3a3a",
    "--border-color": "#333333",
    "--bg-hover": "#2a2a2a",
    "--bg-selected": "#303030",
    "--text-primary": "#dadada",
    "--text-secondary": "#a3a3a3",
    "--text-muted": "#737373",
    "--accent": "#6f9fd8",
    "--accent-green": "#7ab87a",
    "--accent-yellow": "#d7c28c",
    "--accent-red": "#e06c6c",
    "--accent-orange": "#d9895a",
    "--accent-notable": "#9aa4b1",
    "--header-bar-top": "#1e1e1e",
    "--header-bar-bottom": "#1e1e1e",
    "--header-fg": "#dadada",
    "--header-divider": "#333333",
    "--focus-header-underline": "#6f9fd8",
    "--focus-pill-bg": "#dadada",
    "--header-badge-bg": "#dadada",
    "--header-badge-fg": "#1e1e1e",
    "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.35)",
    "--shadow-md": "0 6px 18px rgba(0, 0, 0, 0.4)",
    "--shadow-lg": "0 8px 28px rgba(0, 0, 0, 0.45)"
  },
  "light": {
    "--bg-primary": "#ffffff",
    "--bg-secondary": "#f6f6f6",
    "--bg-tertiary": "#ebebeb",
    "--bg-quaternary": "#dedede",
    "--border-color": "#e3e3e3",
    "--bg-hover": "#f2f2f2",
    "--bg-selected": "#ededed",
    "--text-primary": "#222222",
    "--text-secondary": "#5c5c5c",
    "--text-muted": "#8f8f8f",
    "--accent": "#3d7cc9",
    "--text-on-accent": "#ffffff",
    "--accent-green": "#2e7d32",
    "--accent-yellow": "#8a6d2f",
    "--accent-red": "#c62828",
    "--accent-orange": "#c2622f",
    "--accent-notable": "#5f6b7a",
    "--header-bar-top": "#ffffff",
    "--header-bar-bottom": "#ffffff",
    "--header-fg": "#222222",
    "--header-divider": "#e3e3e3",
    "--focus-header-underline": "#3d7cc9",
    "--focus-pill-bg": "#222222",
    "--header-badge-bg": "#222222",
    "--header-badge-fg": "#ffffff",
    "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.06)",
    "--shadow-md": "0 6px 18px rgba(0, 0, 0, 0.08)",
    "--shadow-lg": "0 8px 28px rgba(0, 0, 0, 0.1)"
  }
}
