{
  "name": "Harbour",
  "description": "Deep teal with a brass accent, a flat header that melts into the page, and an underline for focus.",
  "author": "Look Studio",
  "credit": "A Look Studio original, after a harbour at dusk.",
  "family": "blue",
  "tokens": {
    "--radius-control": "0.375rem",
    "--radius-surface": "0.625rem",
    "--header-gradient": "var(--header-bar-top)",
    "--focus-header-tint": "transparent",
    "--focus-header-underline": "var(--accent)",
    "--focus-header-underline-width": "2px"
  },
  "dark": {
    "--bg-primary": "#0f2327",
    "--text-primary": "#e3ecea",
    "--accent": "#d4a650",
    "--accent-green": "#7fbf9a",
    "--accent-red": "#e07a6a",
    "--header-bar-top": "#0f2327",
    "--header-bar-bottom": "#0f2327",
    "--header-fg": "#e3ecea",
    "--header-divider": "#1f3a3f",
    "--header-badge-bg": "#d4a650",
    "--header-badge-fg": "#0f2327",
    "--syntax-string": "#c9b27a",
    "--syntax-keyword": "#7fb8c0"
  },
  "light": {
    "--bg-primary": "#f4f1ea",
    "--text-primary": "#1d2b2e",
    "--accent": "#9a6b1c",
    "--accent-green": "#2f7a53",
    "--accent-red": "#b3432f",
    "--header-bar-top": "#f4f1ea",
    "--header-bar-bottom": "#f4f1ea",
    "--header-fg": "#1d2b2e",
    "--header-divider": "#ddd6c8",
    "--header-badge-bg": "#9a6b1c",
    "--header-badge-fg": "#ffffff"
  }
}
