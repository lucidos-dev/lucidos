    "--accent-notable": "#525252",
    "--header-bar-top": "#ffffff",
    "--header-bar-bottom": "#ffffff",
    "--header-fg": "#000000",
    "--header-divider": "#e5e5e5",
    "--header-badge-bg": "#000000",
    "--header-badge-fg": "#ffffff",
    "--focus-header-underline": "#000000",
    "--focus-pill-bg": "#000000",
    "--syntax-key": "#000000",
    "--syntax-string": "#525252",
    "--syntax-number": "#404040",
    "--syntax-keyword": "#000000",
    "--syntax-comment": "#8f8f8f",
    "--syntax-control": "#000000",
    "--syntax-type": "#404040",
