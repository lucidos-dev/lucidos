{
  "name": "Mono",
  "description": "Pure black or pure white, with no colour accent. Only errors and success keep a hue.",
  "author": "Lucidos",
  "credit": "A Lucidos original, after the black-and-white minimal style.",
  "family": "neutral",
  "fonts": { "ui": "geist-mono" },
  "tokens": {
    "--radius-control": "0.375rem",
    "--radius-surface": "0.5rem",
    "--header-gradient": "var(--header-bar-top)",
    "--focus-header-tint": "transparent",
    "--focus-pill-glow": "none"
  },
  "dark": {
    "--bg-primary": "#000000",
    "--bg-secondary": "#0a0a0a",
    "--bg-tertiary": "#171717",
    "--bg-quaternary": "#262626",
    "--bg-hover": "#181818",
    "--bg-selected": "#1c1c1c",
    "--border-color": "#262626",
    "--surface-bg": "#111111",
    "--picked-surface": "#1c1c1c",
    "--text-primary": "#ffffff",
    "--text-secondary": "#a1a1a1",
    "--text-muted": "#707070",
    "--accent": "#ffffff",
    "--accent-light": "#d4d4d4",
    "--text-on-accent": "#000000",
    "--accent-green": "#6cc070",
    "--accent-yellow": "#d7c28c",
    "--accent-red": "#f87171",
    "--accent-orange": "#e0895a",
    "--accent-notable": "#a1a1a1",
    "--header-bar-top": "#000000",
    "--header-bar-bottom": "#000000",
    "--header-fg": "#ffffff",
    "--header-divider": "#262626",
    "--header-badge-bg": "#ffffff",
