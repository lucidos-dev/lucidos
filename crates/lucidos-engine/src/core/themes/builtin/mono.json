    "--focus-header-underline": "#ffffff",
    "--focus-pill-bg": "#ffffff",
    "--syntax-key": "#ffffff",
    "--syntax-string": "#a1a1a1",
    "--syntax-number": "#d4d4d4",
    "--syntax-keyword": "#ffffff",
    "--syntax-comment": "#666666",
    "--syntax-control": "#ffffff",
    "--syntax-type": "#d4d4d4",
    "--syntax-function": "#ffffff",
    "--shadow-sm": "0 2px 8px rgba(0, 0, 0, 0.6)",
    "--shadow-md": "0 6px 18px rgba(0, 0, 0, 0.7)",
    "--shadow-lg": "0 8px 28px rgba(0, 0, 0, 0.8)"
