{
  "name": "Paper",
  "description": "Warm sepia pages with ink-brown text. Light mode only.",
  "author": "Lucidos",
  "credit": "A Lucidos original, after printed paper.",
  "family": "warm",
  "fonts": { "ui": "source-serif-4" },
  "light": {
    "--bg-primary": "#f4ecd8",
    "--bg-secondary": "#efe5cc",
    "--bg-tertiary": "#e6dabc",
    "--bg-quaternary": "#dccfae",
    "--border-color": "#dccfae",
    "--bg-hover": "#ede3c8",
    "--bg-selected": "#e6dabc",
    "--text-primary": "#433422",
    "--text-secondary": "#6b5a43",
    "--text-muted": "#8f7c61",
    "--accent": "#9c5b2e",
    "--text-on-accent": "#f8f1e0",
    "--accent-light": "#b3622a",
    "--accent-green": "#5b7a2e",
    "--accent-yellow": "#8a6a1f",
    "--accent-red": "#a8322d",
    "--accent-orange": "#b3622a",
    "--accent-notable": "#7a6a55",
    "--syntax-key": "#2f5d7c",
    "--syntax-string": "#5b7a2e",
    "--syntax-number": "#9c5b2e",
    "--syntax-keyword": "#a8322d",
    "--syntax-comment": "#8f7c61",
    "--syntax-control": "#7a3e6a",
    "--syntax-type": "#8a6a1f",
    "--syntax-function": "#2f5d7c",
    "--radius-control": "0.25rem",
    "--radius-surface": "0.375rem",
    "--header-bar-top": "#e9dcbc",
    "--header-bar-bottom": "#e2d3ae",
    "--header-fg": "#433422",
    "--focus-header-tint": "transparent",
