{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lucidos/appearance": ["../../packages/lucidos-sdk/src/appearance.ts"],
      "@lucidos/engine-constants": ["../../packages/lucidos-sdk/src/generated/engine-constants.ts"],
      "@lucidos/event-stream": ["../../packages/lucidos-sdk/src/eventStream.ts"],
      "@lucidos/find": ["../../packages/lucidos-sdk/src/find.ts"],
      "@lucidos/font-faces": ["../../packages/lucidos-sdk/src/fontFaces.ts"],
      "@lucidos/geometry": ["../../packages/lucidos-sdk/src/geometry.ts"],
      "@lucidos/one-sound": ["../../packages/lucidos-sdk/src/oneSound.ts"],
      "@lucidos/pane-swipe": ["../../packages/lucidos-sdk/src/paneSwipe.ts"],
      "@lucidos/preference-catalog": ["../../packages/lucidos-sdk/src/generated/preference-catalog.ts"],
      "@lucidos/pull-to-refresh": ["../../packages/lucidos-sdk/src/pullToRefresh.ts"],
      "@lucidos/text-entry": ["../../packages/lucidos-sdk/src/textEntry.ts"],
      "@lucidos/tooltip": ["../../packages/lucidos-sdk/src/tooltip.ts"],
      "@lucidos/widget-frame": ["../../packages/lucidos-sdk/src/widgetFrame.ts"]
    }
  },
  "include": ["src"]
}
