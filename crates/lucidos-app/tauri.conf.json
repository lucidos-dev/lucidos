{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucidos",
  "version": "0.1.0",
  "identifier": "com.lucidos.app",
  "build": {
    "frontendDist": "./dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build && ../../scripts/check-staged-copies.sh",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Lucidos",
        "width": 1024,
        "height": 768,
        "minWidth": 480,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "© 2026 Kenneth Tiller",
    "shortDescription": "Your AI-native workspace",
    "longDescription": "Lucidos builds and runs the apps and automations you describe. They run with the assistant in one workspace on your own machine, and share its data, memory and connected accounts. A trigger can run a script, start the assistant, or hand a job to a coding agent.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lucidos-dev/lucidos/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NDFCOUJEMTk1NzRCNUUKUldSZVMxY1p2YmxCOU5WcTYzV0o5elF1MERmZjY0d2FvbUNvTWRITVFueTRQd2lNNzRPRWVOMWkK"
    }
  }
}
