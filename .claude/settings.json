{
  "permissions": {
    "allow": [
      "Bash(./scripts/status.sh*)",
      "Bash(./scripts/test-engine.sh*)",
      "Bash(./scripts/e2e-api.sh*)",
      "Bash(./scripts/e2e-browser.sh*)",
      "Bash(./scripts/e2e-wasm.sh*)",
      "Bash(./scripts/e2e-embedder.sh*)",
      "Bash(./scripts/e2e.sh*)",
      "Bash(./scripts/new-migration.sh*)",
      "Bash(./scripts/check-em-dashes.sh*)",
      "Bash(./scripts/check-prose.sh*)",
      "Bash(./scripts/check-build-script-paths.sh*)",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm test*)",
      "Bash(make test*)",
      "Bash(make build*)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Read(.claude/hooks/**)"
    ],
    "deny": [
      "Read(./target/**)",
      "Read(./**/dist/**)",
      "Read(./crates/lucidos-app/src/generated/cross-validation-fixture.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-kill.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-em-dashes.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-em-dashes.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prose.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-em-dashes.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prose.sh"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-instructions-loaded.sh"
          }
        ]
      }
    ]
  }
}
