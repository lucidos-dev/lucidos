{
  "scenarios": [
    {
      "name": "chat_message_response_unread",
      "thread_type": "chat",
      "description": "Chat thread: message → stream → response marks unread",
      "steps": [
        {"emit": "MessageReceived"},
        {"emit": "TextStreamed"},
        {"emit": "ResponseGenerated", "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}}
      ]
    },
    {
      "name": "chat_response_canceled",
      "thread_type": "chat",
      "description": "Chat thread: canceled response surfaces in REVIEW so the user can save or archive",
      "steps": [
        {"emit": "MessageReceived"},
        {"emit": "TextStreamed"},
        {"emit": "ResponseCanceled", "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}}
      ]
    },
    {
      "name": "chat_response_failed",
      "thread_type": "chat",
      "description": "Chat thread: failed response surfaces in REVIEW so the user notices the error",
      "steps": [
