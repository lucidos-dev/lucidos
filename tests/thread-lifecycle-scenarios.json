{
  "scenarios": [
    {
      "name": "chat_message_response_unread",
      "thread_type": "chat",
      "description": "Chat thread: message → stream → response marks unread",
      "steps": [
        { "emit": "MessageReceived" },
        { "emit": "TextStreamed" },
        { "emit": "ResponseGenerated", "expected": { "stored_section": "unread", "expected_actions": ["done"] } }
      ]
    },
    {
      "name": "chat_user_reads_thread",
      "thread_type": "chat",
      "description": "Chat thread: response marks unread, then user reads it back to default",
      "steps": [
        { "emit": "MessageReceived" },
        { "emit": "ResponseGenerated" },
        { "emit": "ThreadMarkedRead", "expected": { "stored_section": "default", "expected_actions": [] } }
      ]
    },
    {
      "name": "chat_response_canceled",
      "thread_type": "chat",
      "description": "Chat thread: canceled response does not mark unread",
      "steps": [
        { "emit": "MessageReceived" },
        { "emit": "TextStreamed" },
        { "emit": "ResponseCanceled", "expected": { "stored_section": "default" } }
      ]
    },
    {
      "name": "chat_response_failed",
      "thread_type": "chat",
      "description": "Chat thread: failed response surfaces in REVIEW so the user notices the error",
      "steps": [
        { "emit": "MessageReceived" },
        { "emit": "ResponseFailed", "expected": { "stored_section": "unread" },
          "assert_side_effect": "ThreadMarkedUnread" }
      ]
    },
    {
      "name": "chat_response_aborted",
      "thread_type": "chat",
      "description": "Chat thread: aborted response marks thread as unread so user notices",
