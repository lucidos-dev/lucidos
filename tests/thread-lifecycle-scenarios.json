        {"emit": "ChangeProposed", "payload": {"change_id": "c1", "description": "Fix", "files": ["a.rs"]}},
        {"emit": "CodingAgentIdled", "payload": {"has_changes": true}},
        {"emit": "ChangeApplied", "payload": {"change_id": "c1"}, "expected": {"stored_section": "inbox"}},
        {"emit": "ChangeReverted", "payload": {"change_id": "c1"}, "expected": {"stored_section": "inbox"}}
      ]
    },
    {
      "name": "trigger_lifecycle",
      "thread_type": "chat",
      "description": "Trigger thread follows chat rules — response goes to unread",
      "steps": [
        {"emit": "TriggerStarted", "payload": {"trigger_id": "t1", "trigger_name": "Daily check", "invocation": {"kind": "Schedule"}}},
        {"emit": "ToolCalled", "payload": {"name": "web_search", "args": {}}},
        {"emit": "ToolResult", "payload": {"name": "web_search", "result": "results"}},
        {"emit": "ResponseGenerated", "payload": {"text": "Here are the results"}, "expected": {"stored_section": "inbox"}}
      ]
    },
    {
      "name": "trigger_followup",
      "thread_type": "chat",
      "description": "Trigger thread: user followup response stays in inbox (review)",
      "steps": [
        {"emit": "TriggerStarted", "payload": {"trigger_id": "t1", "trigger_name": "Daily check", "invocation": {"kind": "Schedule"}}},
        {"emit": "ResponseGenerated", "payload": {"text": "Here are the results"}, "expected": {"stored_section": "inbox"}},
        {"emit": "MessageReceived", "payload": {"text": "Can you elaborate?"}, "expected": {"stored_section": "inbox"}},
        {"emit": "ResponseGenerated", "payload": {"text": "Sure, here are the details..."}, "expected": {"stored_section": "inbox"}}
      ]
