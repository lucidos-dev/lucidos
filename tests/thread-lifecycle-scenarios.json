    {
      "name": "cc_resume_after_process_exit",
      "thread_type": "claude_code",
      "description": "CC thread: follow-up after CC process exited — empty ResponseGenerated + CodingAgentIdled still marks unread",
      "steps": [
        {"emit": "MessageReceived", "payload": {"text": "Initial request", "channel": "claude_code"}},
        {"emit": "SessionStarted", "payload": {"session_id": "s1", "branch": "claude-code/initial"}},
        {"emit": "CodingAgentToolCalled"},
        {"emit": "ResponseGenerated", "payload": {"text": "Done with initial work"}},
        {"emit": "CodingAgentIdled", "payload": {"has_changes": false}, "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}},
        {"emit": "ThreadArchived", "expected": {"stored_section": "archived", "expected_actions": []}},
        {"emit": "MessageReceived", "payload": {"text": "Follow-up after process died", "channel": "claude_code"}, "expected": {"status": "running"}},
        {"emit": "SessionStarted", "payload": {"session_id": "", "branch": "claude-code/resume"}, "expected": {"status": "running"}},
        {"emit": "ResponseGenerated", "payload": {}},
        {"emit": "CodingAgentIdled", "payload": {"has_changes": false}, "expected": {"stored_section": "inbox", "expected_actions": ["archive"], "status": "idle"}}
      ]
    },
