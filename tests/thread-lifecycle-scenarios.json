        {"emit": "ResponseFailed", "expected": {"stored_section": "inbox"}}
      ]
    },
    {
      "name": "chat_response_aborted",
      "thread_type": "chat",
      "description": "Chat thread: aborted response marks thread as unread so user notices",
      "steps": [
        {"emit": "MessageReceived"},
        {"emit": "ResponseAborted", "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}}
      ]
    },
    {
      "name": "chat_response_interrupted",
      "thread_type": "chat",
      "description": "Chat thread: response marks unread, new message keeps it unread",
      "steps": [
        {"emit": "MessageReceived"},
        {"emit": "ResponseGenerated", "expected": {"stored_section": "inbox"}},
        {"emit": "MessageReceived", "expected": {"stored_section": "inbox"}}
      ]
    },
    {
