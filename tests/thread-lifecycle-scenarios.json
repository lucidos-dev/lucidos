        { "emit": "MessageReceived" },
        { "emit": "ResponseAborted", "expected": { "stored_section": "unread", "expected_actions": ["done"] }, "assert_side_effect": "ThreadMarkedUnread" }
      ]
    },
    {
      "name": "chat_response_interrupted",
