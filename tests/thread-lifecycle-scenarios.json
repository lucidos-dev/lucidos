        {"emit": "ChangeApplied", "set_pending_changes": false, "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}},
        {"emit": "ChangeDiscarded", "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}}
      ]
    },
