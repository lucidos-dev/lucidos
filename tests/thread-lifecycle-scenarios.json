        {"emit": "CodingAgentToolCalled"},
        {"emit": "ResponseGenerated"},
        {"emit": "ChangeProposed", "set_pending_changes": true},
        {"emit": "CodingAgentIdled", "expected": {"stored_section": "inbox", "expected_actions": ["discard", "apply"]}},
        {"emit": "ChangeApplied", "set_pending_changes": false, "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}}
      ]
    },
