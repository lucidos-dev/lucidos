      "steps": [
        {"emit": "MessageReceived"},
        {"emit": "SessionStarted"},
        {"emit": "CodingAgentIdled", "expected": {"stored_section": "inbox", "expected_actions": ["archive"]}},
        {"emit": "CodingAgentUserMessageSent"},
        {"emit": "CodingAgentToolCalled"},
